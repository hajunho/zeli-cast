# ZeliCast server API keys — copy this file to .env and fill in your own keys.
# Every key is OPTIONAL: sources without a key are skipped automatically,
# and the app still works with the keyless Open-Meteo source.

# 기상청 KMA (Korea Meteorological Administration) — free 10,000 calls/day
# Get one at https://data.go.kr
KMA_API_KEY=

# OpenWeatherMap — free tier available at https://openweathermap.org/api
OWM_API_KEY=

# Tomorrow.io — free tier available at https://www.tomorrow.io/weather-api/
TOMORROW_API_KEY=

# WeatherAPI — free tier available at https://www.weatherapi.com
WEATHERAPI_KEY=

# SerpAPI (news / stock / nearby places features) — https://serpapi.com
SERPAPI_KEY=
